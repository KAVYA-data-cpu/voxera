# Backend environment variables (copy to backend/.env and fill in real values)

DATABASE_URL=postgresql://username:password@localhost:5432/voxera
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_ORIGIN=http://localhost:5173
APP_NAME=Voxera

# Tencent Hunyuan3D remote provider (never commit real secrets)
# Point this at a self-hosted or hosted Hunyuan3D API server.
# The open-source Hunyuan3D server documents /send and /status/{uid}.
HUNYUAN3D_BASE_URL=http://your-gpu-server:8080
HUNYUAN3D_API_KEY=
HUNYUAN3D_TIMEOUT_SECONDS=30
HUNYUAN3D_JOB_TIMEOUT_SECONDS=900
HUNYUAN3D_POLL_INTERVAL_SECONDS=5
HUNYUAN3D_MAX_IMAGE_BYTES=10485760
HUNYUAN3D_MAX_CONCURRENT_JOBS=2
HUNYUAN3D_MAX_USER_ACTIVE_JOBS=2
HUNYUAN3D_OUTPUT_DIR=generated_models